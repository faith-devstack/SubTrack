rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Trusted Admin Verification: Verified Database Role or Bootstrapped Primary Owner
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == "abejidefaith110@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrappedAdmin()
      );
    }

    // Subscription Entity Validation
    function isValidSubscription(data) {
      return data.keys().hasAll(['user_id', 'name', 'cost', 'billing_cycle', 'category', 'next_renewal_date', 'status', 'created_at'])
        && data.keys().size() == 8
        && data.user_id is string && data.user_id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.cost is number
        && data.billing_cycle in ['monthly', 'yearly']
        && data.category is string && data.category.size() <= 50
        && data.next_renewal_date is string && data.next_renewal_date.size() <= 30
        && data.status in ['active', 'canceled']
        && data.created_at is string && data.created_at.size() <= 30;
    }

    // User Profile Entity Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['user_id', 'email', 'role', 'status', 'created_at'])
        && data.user_id is string && data.user_id.size() <= 128
        && data.email is string && data.email.size() <= 150
        && data.role in ['user', 'admin']
        && data.status in ['active', 'suspended']
        && data.created_at is string && data.created_at.size() <= 30;
    }

    // -------------------------------------------------------------------------
    // Subscriptions Collection
    // -------------------------------------------------------------------------
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (existing().user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() 
        && isValidId(subscriptionId)
        && isValidSubscription(incoming())
        && incoming().user_id == request.auth.uid;

      allow update: if isSignedIn() 
        && isValidSubscription(incoming())
        && (
          (existing().user_id == request.auth.uid && incoming().user_id == existing().user_id && incoming().created_at == existing().created_at) ||
          isAdmin()
        );

      allow delete: if isSignedIn() && (existing().user_id == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Users Profile Collection (Platform User Directory)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Normal users can initialize their own profile as 'user' and 'active'
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          (request.auth.uid == userId && incoming().user_id == request.auth.uid && incoming().role == 'user' && incoming().status == 'active') ||
          isAdmin()
        );

      // Normal users can update their profile but cannot change their own role or status
      // Admins can update status (suspend/reactivate) and role
      allow update: if isSignedIn()
        && isValidUserProfile(incoming())
        && (
          (request.auth.uid == userId && incoming().user_id == existing().user_id && incoming().role == existing().role && incoming().status == existing().status) ||
          isAdmin()
        );

      allow delete: if isAdmin() && request.auth.uid != userId; // Admins cannot delete own account via admin panel
    }

    // -------------------------------------------------------------------------
    // Admins Collection (Role-Based Access Control)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();

      // Bootstrapped setup or admin delegation
      allow create, update: if isSignedIn()
        && isValidId(adminId)
        && (isAdmin() || (isBootstrappedAdmin() && request.auth.uid == adminId));

      // Prevent removing the last admin or removing oneself accidentally
      allow delete: if isAdmin() && request.auth.uid != adminId;
    }

    // -------------------------------------------------------------------------
    // Admin Audit Logs Collection (Immutable Audit Trail)
    // -------------------------------------------------------------------------
    match /admin_audit_logs/{logId} {
      allow read, list: if isAdmin();
      
      allow create: if isAdmin()
        && isValidId(logId)
        && incoming().admin_id == request.auth.uid
        && incoming().status in ['success', 'failure'];

      // Audit logs are strictly immutable: no updates or deletions allowed
      allow update, delete: if false;
    }
  }
}
